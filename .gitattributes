# Binary test fixtures must never go through line-ending normalization.
#
# tests/fixtures/encrypted-statement.pdf is an ENCRYPTED PDF: its object stream
# offsets and encryption dictionary are byte-exact. Git on Windows was about to
# apply LF->CRLF to it ("LF will be replaced by CRLF" on `git add`), which would
# have shifted every byte after the first newline and produced a fixture that
# fails to parse on checkout — a broken raster-path test that looks like a
# broken watermarker.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.wasm binary
*.ico binary

# lib/install-scripts.ts embeds the install scripts as String.raw templates, so
# the bytes of the file ARE the bytes served. Git on Windows (core.autocrlf=true)
# would check it out with CRLF, and a build from that checkout would serve
# install.sh with a carriage return on every line, which bash rejects.
# tests/f0-containment.test.ts pins the sha256 of both scripts.
lib/install-scripts.ts text eol=lf
