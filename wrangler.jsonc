{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasis-command-center",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "DEPLOY_ENV": "production",
    "DEPLOY_PLATFORM": "cloudflare",
    "DEPLOY_SURFACE": "oasis"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "oasis-command-center" },
    // The SEO screen reads oasis-seo-measure's /v1 API over this binding (keys: SEO_READ_TOKEN,
    // SEO_MANAGE_TOKEN, pushed by JARVIS `node scripts/oasis_seo_ops.mjs occ-secrets`).
    { "binding": "SEO_MEASURE", "service": "oasis-seo-measure" }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  }
}
