{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasis-command-center",
  "main": "worker-entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "DEPLOY_ENV": "production",
    "DEPLOY_PLATFORM": "cloudflare",
    "DEPLOY_SURFACE": "oasis"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "oasis-command-center" },
    { "binding": "SEO_MEASURE", "service": "oasis-seo-measure" }
  ],
  "queues": {
    "producers": [
      { "binding": "TELEGRAM_AGENT_JOBS", "queue": "oasis-telegram-agent-jobs" },
      { "binding": "MAVEN_PUBLISH_JOBS", "queue": "oasis-maven-publish-jobs" }
    ],
    "consumers": [
      {
        "queue": "oasis-telegram-agent-jobs",
        "max_batch_size": 1,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "oasis-telegram-agent-jobs-dlq"
      },
      {
        "queue": "oasis-maven-publish-jobs",
        "max_batch_size": 1,
        "max_retries": 5,
        "dead_letter_queue": "oasis-maven-publish-jobs-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "region": "aws:us-west-2"
  }
}
