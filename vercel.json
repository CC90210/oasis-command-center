{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev --port 3100",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/materialize-plans",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/collect-outreach-intel?write=1",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/collect-cc-metrics?write=1",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/dispatch-scheduled-sends",
      "schedule": "*/5 * * * *"
    }
  ]
}
