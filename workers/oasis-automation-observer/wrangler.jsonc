{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oasis-automation-observer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "OBSERVER", "class_name": "ObserverIncident" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ObserverIncident"] }],
  "observability": { "enabled": true }
}
