{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oasis-cc-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "triggers": {
    // One minute-tick; src/index.ts evaluates the 28-entry table per tick.
    // Verbatim schedules live in CRON_TABLE, diffable against vercel.json.
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
